{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "strict": true,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    //  SUPPRESS DEPRECATION WARNING
    "ignoreDeprecations": "6.0",

    //  KEEP ALIAS (still required)
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}